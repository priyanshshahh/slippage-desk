# Alpaca paper trading credentials (hackathon judging account)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Options data feed: "indicative" (free tier) or "opra" (paid subscription)
ALPACA_OPTIONS_FEED=indicative

# Optional. The advisor prefers the `claude` CLI, which runs on an existing
# Claude subscription and needs no API credits. Set this only if you want to
# use the API directly instead. Absent AND no CLI means every candidate is
# vetoed, which is the intended fail-closed behaviour.
# ANTHROPIC_API_KEY=

# Advisor fallback for any OpenAI-compatible endpoint (Ollama, Groq, Gemini).
# Only needed if the `claude` CLI is unavailable. Example for local Ollama:
#   ADVISOR_BASE_URL=http://localhost:11434/v1
# ADVISOR_BASE_URL=
# ADVISOR_API_KEY=
